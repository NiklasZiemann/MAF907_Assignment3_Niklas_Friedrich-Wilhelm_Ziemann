# Data that is NOT committed
#   WRDS extracts are licensed and stay on the machine that downloaded them (script 02 re-creates them;
#   docs/data_manifest.md carries their row counts and checksums so a reader can confirm their own pull)
data/raw/wrds/*
!data/raw/wrds/.gitkeep
#   processed files are rebuilt by scripts 03 to 06
data/processed/*
!data/processed/.gitkeep

# Data that IS committed (nothing above matches it):
#   data/raw/paper/      the printed cells of Frank and Goyal (2003) transcribed, for the comparisons
#   data/raw/public/     the FRED deflator series (small, public)

# Output is regenerated by the scripts
output/tables/*
output/figures/*
!output/tables/.gitkeep
!output/figures/.gitkeep
output/log_*.txt
Rplots.pdf

# Local configuration (WRDS user name), see README; config_example.csv is the template
config.csv

# RStudio and R session files
.Rproj.user/
.Rhistory
.RData
.Ruserdata
